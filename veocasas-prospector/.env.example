# URL pública del deploy (sin barra final)
BASE_URL=https://veocasas-prospector.vercel.app

# Seguridad
CRON_SECRET=cambiar-por-string-largo-aleatorio
UNSUB_SECRET=otro-string-largo-mas
DASHBOARD_PASSWORD=clave-del-panel

# Firebase (cuenta de servicio del proyecto del CRM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gmail (casilla que envía; correr `npm run gmail-token` para obtener el refresh token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SENDER_EMAIL=comercial@veocasas.com.uy
SENDER_NAME=Emi de Veocasas
ADMIN_EMAIL=emi@veocasas.com.uy

# Ejecutivos: etapas = caliente | cierre ; departamentos opcional
EXECUTIVES_JSON=[{"nombre":"Ana Pérez","email":"ana@veocasas.com.uy","etapas":["caliente","cierre"]},{"nombre":"Juan Gómez","email":"juan@veocasas.com.uy","etapas":["caliente"],"departamentos":["Maldonado","Rocha"]}]

# Envío
DAILY_NEW_LIMIT=25
AUTO_REPLY_INFO=true
AGENDA_URL=https://calendar.app.google/tu-link

# Proveedores
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Fuentes de la búsqueda mensual (coma): maps,google. Los portales y cámaras los rastrea GitHub Actions.
FUENTES=maps,google
