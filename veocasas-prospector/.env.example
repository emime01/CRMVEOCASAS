# URL pública del deploy (sin barra final)
BASE_URL=https://veocasas-prospector.vercel.app

# Seguridad
CRON_SECRET=cambiar-por-string-largo-aleatorio
UNSUB_SECRET=otro-string-largo-mas
DASHBOARD_PASSWORD=clave-del-panel

# Firebase (proyecto del CRM). Elegir UNA forma de autenticar:
FIREBASE_PROJECT_ID=crmveocasas-4fc8c
# a) En Vercel, sin claves (federación de identidades; ver README):
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/218951782203/locations/global/workloadIdentityPools/vercel/providers/vercel
GCP_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-fbsvc@crmveocasas-4fc8c.iam.gserviceaccount.com
# b) Con clave de cuenta de servicio (hoy la organización no deja crearlas):
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# c) En tu compu: nada de lo anterior, y correr `gcloud auth application-default login`.

# Gmail (casilla que envía; correr `npm run gmail-token` para obtener el refresh token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SENDER_EMAIL=comercial@veocasas.com.uy
SENDER_NAME=Emi de Veocasas
ADMIN_EMAIL=emi@veocasas.com.uy

# Ejecutivos: etapas = caliente | cierre ; departamentos opcional
EXECUTIVES_JSON=[{"nombre":"Ana Pérez","email":"ana@veocasas.com.uy","etapas":["caliente","cierre"]},{"nombre":"Juan Gómez","email":"juan@veocasas.com.uy","etapas":["caliente"],"departamentos":["Maldonado","Rocha"]}]

# Pruebas y lanzamiento
# Con MODO_PRUEBA_EMAIL, todos los correos van a esa casilla (distinta de SENDER_EMAIL). Vaciarlo para lanzar.
MODO_PRUEBA_EMAIL=tu-casilla-de-pruebas@gmail.com
# Los crons solo corren con AGENTE_ACTIVO=true. Mientras tanto, se prueba con los botones del panel.
AGENTE_ACTIVO=false

# Envío
DAILY_NEW_LIMIT=25

# Tope de llamadas a Places por mes (hora UY). El tramo gratis es 1.000; Google no deja bajar la cuota diaria.
PLACES_MONTHLY_LIMIT=900
AUTO_REPLY_INFO=true
AGENDA_URL=https://calendar.app.google/tu-link

# Proveedores
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Fuentes de la búsqueda (coma): maps,google,directorios
FUENTES=maps,google,directorios
